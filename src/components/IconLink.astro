---
type Props = {
  href: string;
  label: string;
  icon: 'github' | 'linkedin' | 'mail' | 'arrow';
};

const { href, label, icon } = Astro.props;
---

<a class="icon-link" href={href} target={icon === 'mail' ? undefined : '_blank'} rel={icon === 'mail' ? undefined : 'noreferrer'} aria-label={label}>
  {icon === 'github' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 .5A11.5 11.5 0 0 0 8.36 22.9c.58.11.79-.25.79-.56v-2.16c-3.22.7-3.9-1.37-3.9-1.37-.53-1.35-1.3-1.71-1.3-1.71-1.06-.72.08-.71.08-.71 1.17.08 1.79 1.2 1.79 1.2 1.04 1.78 2.73 1.27 3.4.97.1-.75.41-1.27.74-1.56-2.57-.29-5.27-1.29-5.27-5.73 0-1.27.45-2.3 1.2-3.11-.12-.29-.52-1.48.11-3.07 0 0 .98-.31 3.18 1.19a11.1 11.1 0 0 1 5.8 0c2.2-1.5 3.17-1.19 3.17-1.19.64 1.59.24 2.78.12 3.07.75.81 1.2 1.84 1.2 3.11 0 4.45-2.71 5.43-5.29 5.72.42.36.79 1.07.79 2.17v3.18c0 .31.21.68.8.56A11.5 11.5 0 0 0 12 .5Z" />
    </svg>
  )}
  {icon === 'linkedin' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20.45 20.45h-3.56v-5.58c0-1.33-.02-3.04-1.85-3.04-1.86 0-2.14 1.45-2.14 2.94v5.68H9.34V8.98h3.42v1.57h.05a3.75 3.75 0 0 1 3.37-1.85c3.61 0 4.27 2.38 4.27 5.47v6.28ZM5.32 7.41a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.04H3.54V8.98H7.1v11.47ZM22.23 0H1.77C.79 0 0 .77 0 1.72v20.56C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.72V1.72C24 .77 23.21 0 22.23 0Z" />
    </svg>
  )}
  {icon === 'mail' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M3.5 5h17A2.5 2.5 0 0 1 23 7.5v9A2.5 2.5 0 0 1 20.5 19h-17A2.5 2.5 0 0 1 1 16.5v-9A2.5 2.5 0 0 1 3.5 5Zm0 2a.5.5 0 0 0-.5.5v.42l9 5.13 9-5.13V7.5a.5.5 0 0 0-.5-.5h-17Zm17 10a.5.5 0 0 0 .5-.5v-6.28l-8.5 4.85a1 1 0 0 1-.99 0L3 10.22v6.28a.5.5 0 0 0 .5.5h17Z" />
    </svg>
  )}
  {icon === 'arrow' && (
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <path d="M13.5 5.5a1 1 0 0 1 1.42 0l5.58 5.59a1.3 1.3 0 0 1 0 1.82l-5.58 5.59a1 1 0 1 1-1.42-1.41L17.59 13H4.5a1 1 0 1 1 0-2h13.09L13.5 6.91a1 1 0 0 1 0-1.41Z" />
    </svg>
  )}
  <span>{label}</span>
</a>
